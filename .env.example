# Google Gemini API key for server-side AI processing (optional, kept strictly on server)
GEMINI_API_KEY=

# Node Environment ('production' or 'development')
NODE_ENV=production

# Server Port (defaults to 3000)
PORT=3000

# PostgreSQL Database Connection String (optional, fallback to SQLite if omitted)
DATABASE_URL=

# JWT Secret for Session & API Authentication (strong random string in production)
JWT_SECRET=

# Public API URL for Mobile APK & Remote Clients (e.g. https://ais-dev-2fs2pmsfv6pphdldss5sp7-870522842645.europe-west2.run.app)
VITE_API_URL=
